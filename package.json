{
  "name": "versie-cli",
  "version": "1.4.12",
  "description": "Natural language version control for vibe coders — save, ship, and roll back your AI-generated code without touching Git. Works with Cursor, Claude Code, and any MCP client.",
  "type": "module",
  "bin": {
    "versie": "./build/cli.js",
    "versie-cli": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "posthog-node": "^5.28.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "git",
    "version-control",
    "vibe-coding",
    "vibe-coders",
    "cursor",
    "claude-code",
    "claude",
    "mcp",
    "mcp-server",
    "ai-coding",
    "rollback",
    "undo",
    "deploy",
    "safety",
    "no-code",
    "low-code"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/versiehq/cli.git"
  },
  "bugs": {
    "url": "https://github.com/versiehq/cli/issues"
  },
  "homepage": "https://github.com/versiehq/cli#readme"
}
