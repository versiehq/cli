# Versie MCP Server — environment variables
# Copy to .env and fill in your values. Never commit .env.

# PostHog — anonymous telemetry (opt-out by setting VERSIE_TELEMETRY=false)
POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
POSTHOG_HOST=https://us.i.posthog.com

# Set to "false" to disable anonymous telemetry
# VERSIE_TELEMETRY=false

# Supabase — authenticated cloud sync (Phase B2, not yet active)
# VERSIE_API_URL=https://your-project.supabase.co
# VERSIE_API_KEY=your_api_key_here
